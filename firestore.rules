rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Category pages sign visitors in anonymously; that is not an account.
    function isAccount() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    // Posting needs a verified email (sign-up sends the verification link).
    function isVerifiedAccount() {
      return isAccount() && request.auth.token.email_verified == true;
    }

    // Listings: anyone can read; only the owner can create/update/delete their own.
    // Admin edits go through Cloud Functions (Admin SDK bypasses these rules).
    //
    // Paid features are enforced server-side: housing ads and ads with more than 2 photos are
    // created by the createListing Cloud Function, which consumes an unused payments/{id} record
    // and sets the payment fields below. Clients may only write free listings directly, can never
    // set the payment fields, and cannot turn a listing into a paid one by editing it.
    function listingPaymentFields() {
      return ['housingPaymentId', 'extraImagesPaymentId', 'extraImagesPaid'];
    }
    function imageCount(data) {
      return data.get('imageUrls', []).size();
    }
    function imagesAreList(data) {
      return data.get('imageUrls', []) is list;
    }
    // Keep in sync with categoryData in post-ad.html and LISTING_CATEGORIES in functions/listings.js.
    function validCategory(data) {
      let cats = {
        'housing': ['apartments', 'cabins', 'landFarms', 'rentalswanted', 'roomsShared', 'sublets',
          'realEstate', 'vacationRentals'],
        'forSale': ['autoParts', 'carsTrucks', 'electronics', 'clothes', 'booksMedia', 'babyKids',
          'toolsGarden', 'boats', 'farmProduce', 'furniture', 'household', 'motorcycles', 'pets',
          'sportingGoods', 'free'],
        'jobs': ['adminOffice', 'customerService', 'hospitality', 'salesMarketing', 'softwareIT',
          'tourism', 'generalLabor', 'education', 'healthcare', 'construction', 'agriculture'],
        'services': ['automotive', 'beauty', 'computer', 'financial', 'legal', 'lessons', 'petCare',
          'photography', 'propertyCare', 'realestate_service', 'skilledtrade', 'cleaningMoving',
          'toursGuides', 'transportTransfers'],
        'community': ['activities', 'classes', 'conservation', 'events', 'localnews', 'lostfound',
          'volunteers'],
        'personals': ['strictlyplatonic', 'womenseekingmen', 'menseekingwomen', 'menseekingmen',
          'womenseekingwomen']
      };
      return data.get('category', '') in cats
        && data.get('subCategory', '') in cats[data.category];
    }
    // Lifetime fields: a listing runs 30 days from creation and the owner cannot extend it.
    // Marking it sold (profile.html) may set publicVisibleUntil to at most 48h from now.
    function lifetimeUnchanged() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['createdAt', 'expiresAt'])
        && (!changed.hasAny(['publicVisibleUntil'])
          || (request.resource.data.status == 'sold'
            && request.resource.data.publicVisibleUntil is timestamp
            && request.resource.data.publicVisibleUntil <= request.time + duration.value(49, 'h')));
    }

    // Ad contact details must be the account's own (users/{uid}.phone / .contactEmail); post-ad
    // only lets sellers choose which to show, and createListing copies them server-side.
    function contactsMatchAccount(data) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return (data.get('contactPhone', '') == '' || data.get('contactPhone', '') == profile.get('phone', ''))
        && (data.get('contactEmail', '') == '' || data.get('contactEmail', '') == profile.get('contactEmail', ''));
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if isVerifiedAccount()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('category', '') != 'housing'
        && validCategory(request.resource.data)
        && imagesAreList(request.resource.data)
        && imageCount(request.resource.data) <= 2
        && !request.resource.data.keys().hasAny(listingPaymentFields().concat(['featured', 'suspended', 'suspendedAt']))
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(31, 'd')
        && request.resource.data.get('publicVisibleUntil', request.resource.data.expiresAt)
          == request.resource.data.expiresAt
        && request.resource.data.get('status', 'active') == 'active'
        && contactsMatchAccount(request.resource.data);
      // Photo limit on edit: 2 free, 5 once extra photos were paid for; listings that already
      // had more photos (before this rule) may keep that many but not grow.
      allow update: if isAccount()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(listingPaymentFields().concat(['featured', 'suspended', 'suspendedAt']))
        && lifetimeUnchanged()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['contactPhone', 'contactEmail'])
          || contactsMatchAccount(request.resource.data))
        && (request.resource.data.get('category', '') != 'housing'
          || resource.data.get('category', '') == 'housing')
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['category', 'subCategory'])
          || validCategory(request.resource.data))
        && imagesAreList(request.resource.data)
        && (imageCount(request.resource.data) <= 2
          || imageCount(request.resource.data) <= imageCount(resource.data)
          || (resource.data.get('extraImagesPaid', false) == true
            && imageCount(request.resource.data) <= 5));
      allow delete: if isAccount()
        && resource.data.userId == request.auth.uid;
    }

    // User data: only the signed-in user can read/write their own (referral stats server-only)
    // Profiles: name, full name and phone are set once at sign-up; after that only admins
    // change them (adminUpdateUser), so a verified account can't later take on someone else's
    // identity. Users may refresh lastActiveAt/email (app.js presence); referral stats are
    // server-only.
    function signupFields() {
      return ['email', 'createdAt', 'displayName', 'fullName', 'phone', 'contactEmail', 'lastActiveAt'];
    }
    function validPhone(v) {
      return v is string && v.matches('^[+]?[0-9][0-9 ()-]{6,19}$');
    }
    function validEmail(v) {
      return v is string && v.size() <= 254 && v.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$');
    }
    // Ad contact phone / email: optional, but well-formed when present
    function contactsWellFormed(data) {
      return (data.get('phone', '') == '' || validPhone(data.get('phone', '')))
        && (data.get('contactEmail', '') == '' || validEmail(data.get('contactEmail', '')));
    }
    // A missing contact detail can be added once (profile page); after that only admins change it
    function addsMissingContactsOnly() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['phone', 'contactEmail', 'lastActiveAt'])
        && (!changed.hasAny(['phone'])
          || (resource.data.get('phone', '') == '' && validPhone(request.resource.data.get('phone', ''))))
        && (!changed.hasAny(['contactEmail'])
          || (resource.data.get('contactEmail', '') == '' && validEmail(request.resource.data.get('contactEmail', ''))));
    }
    function emailMatchesAccount(data) {
      return !data.keys().hasAny(['email']) || data.email == request.auth.token.get('email', null);
    }
    match /users/{userId} {
      allow read: if isAccount() && request.auth.uid == userId;
      allow create: if isAccount() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(signupFields())
        && emailMatchesAccount(request.resource.data)
        && contactsWellFormed(request.resource.data);
      allow update: if isAccount() && request.auth.uid == userId
        && emailMatchesAccount(request.resource.data)
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt', 'email'])
          || addsMissingContactsOnly()
          // sign-up's profile write can land after the first presence write
          || (!resource.data.keys().hasAny(['displayName', 'fullName', 'phone', 'contactEmail'])
            && request.resource.data.keys().hasOnly(signupFields())
            && contactsWellFormed(request.resource.data)));
    }
    // User favorites subcollection (required for favorites to load on search/category pages)
    match /users/{userId}/favorites/{favoriteId} {
      allow read, write: if isAccount() && request.auth.uid == userId;
    }

    // Admins: only the user can read their own doc (to check if they are admin). No client write.
    match /admins/{userId} {
      allow read: if isAccount() && request.auth.uid == userId;
      allow write: if false;
    }

    // Payments: written by Cloud Functions only; users may read their own records
    match /payments/{paymentId} {
      allow read: if isAccount() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Promo codes and redemptions: Cloud Functions / admin only
    match /promo-codes/{codeId} {
      allow read, write: if false;
    }
    match /promo-redemptions/{redemptionId} {
      allow read, write: if false;
    }

    // Referral records and share logs: Cloud Functions only
    match /referrals/{referralId} {
      allow read, write: if false;
    }
    match /referral-shares/{shareId} {
      allow read, write: if false;
    }
    match /referral-pending/{userId} {
      allow read, write: if false;
    }

    // Help / support requests: signed-in users may submit; admins update via Cloud Functions only
    match /help-requests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'email', 'topic', 'message', 'status', 'submittedAt']);
      allow read, update, delete: if false;
    }
  }
}
